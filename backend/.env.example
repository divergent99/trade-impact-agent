# Required
ANTHROPIC_API_KEY=
BALLDONTLIE_API_KEY=
TAVILY_API_KEY=

# Optional (defaults shown)
# PORT=8000
# ALLOWED_ORIGINS=*                  # comma-separated, e.g. https://trade-desk.vercel.app
# GATHER_MODEL=claude-haiku-4-5-20251001
# FINALIZE_MODEL=claude-sonnet-4-6
# MAX_GATHER_TURNS=4
# RUN_TIMEOUT_SECONDS=150
# MAX_CONCURRENT_RUNS=4
# RATE_LIMIT_PER_HOUR=20             # per client IP, 0 disables
# BDL_REQUESTS_PER_MIN=55            # your balldontlie plan's limit minus headroom (free 5, ALL-STAR 60, GOAT 600)
# TOOL_TIMEOUT_SECONDS=30
